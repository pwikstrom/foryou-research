# Environment variables used by the For You Data Hub. Copy relevant lines into your shell
# profile or a local .env (gitignored) — full reference: docs/configuration.md
#
# A .env file at the project root is loaded automatically when the app
# starts. Values you have already exported in the shell always take
# precedence over the file.
#
# None of these are required for a local, GCS-free run (see
# config/config.local.toml.example for the storage toggles).

# Gemini API access (annotation, embeddings) via the plain Gemini API.
# NOT sufficient on its own: this key is only used when [machine].vertexai is
# set to false in config/config.local.toml. The default is vertexai = true,
# which uses Vertex AI and a GCP project instead. Full walkthrough of both
# options: docs/installation.md#enabling-gemini-later
#GEMINI_API_KEY=

# API key for the hosted Qwen backends (DashScope, OpenAI-compatible intl
# endpoint). Needed only when the active annotation backend is `qwen_api` (or
# one of its variants) or the embedding backend is the Qwen API one — both read
# this same key. Selected under Admin -> Backends; configured in the
# [machine.qwen_api] / [embeddings.*] config blocks.
#DASHSCOPE_API_KEY=

# Flask session secret. Falls back to a dev-only value locally; REQUIRED in
# any deployed environment.
#FLASK_SECRET_KEY=

# GCS bucket for data/media/cache when the use_gcs_* toggles are on.
#FYP_GCS_BUCKET_NAME=

# Force ALL storage to GCS from a local process (e.g. the local scrape-queue
# drain runbook in DEVELOPING.md). Refuses local fallback if GCS is unreachable.
#FYP_FORCE_GCS=1

# Ignore any runtime-uploaded annotation contract; use the committed one.
# Set by tests and the golden safety net.
#FYP_BAKED_CONTRACTS_ONLY=1

# Use this config TOML directly instead of discovering config/config.toml
# via the __proj__.py sentinel (for reusing fyp inside another project).
#FYP_CONFIG_PATH=

# Optional Flask debug toggle (local only; enables the auto-reloader).
#FLASK_DEBUG=1

# Instance branding — env overrides of the [site] config section (locally
# these are usually set in config/config.local.toml instead; the deployed
# services use these env vars).
# Outbound mail no-ops unless BOTH the sender and MAIL_PASSWORD are set.
#MAIL_PASSWORD=
#FYP_MAIL_SENDER=
# Public URL of this instance — "log in at ..." links in outbound emails, and
# the canonical origin for SEO (canonical <link>, sitemap, JSON-LD, www→apex
# redirect). Never point it at the raw *.run.app host.
#FYP_APP_URL=
# Domain for placeholder p-N@<domain> participant account addresses
# (default: foryouresearch.net).
#FYP_PARTICIPANT_PLACEHOLDER_DOMAIN=
# Contact email shown on public guide/FAQ + the home-tab feedback note
# (those passages are hidden when unset).
#FYP_CONTACT_EMAIL=
# Source-repository URL the public pages link to for bug reports, the
# installation guide and the licence. Defaults to the canonical repository;
# set your fork here, or an empty string to drop the links.
#FYP_REPO_URL=

# Slack feed on the Home tab (optional; the feature is hidden while unset).
#SLACK_BOT_TOKEN=
#SLACK_CHANNEL_ID=

# Vertex AI project override for Gemini annotation. When [machine].project is
# empty, the app falls back to FYP_VERTEX_PROJECT, then GCP_PROJECT_ID
# (already present on the Cloud Run services).
#FYP_VERTEX_PROJECT=

# Log level for fyp modules (DEBUG/INFO/WARNING/ERROR; default INFO). Logs go
# to stdout with a bare message format so subprocess-worker UI log lines are
# unchanged.
#FYP_LOG_LEVEL=INFO

# AWS credentials for the AIO donation fetch (standard boto3 chain; only
# needed with access to the AIO data-donation stack — ~/.aws/credentials
# works too). Without them the AIO fetch task fails harmlessly.
#AWS_ACCESS_KEY_ID=
#AWS_SECRET_ACCESS_KEY=
#AWS_DEFAULT_REGION=

# The AIO stack's DynamoDB table and S3 bucket. These names are generated per
# CloudFormation deployment, so they are configuration rather than constants;
# the AIO fetch raises a clear error if they are unset. Only installations
# with their own AIO data-donation stack need them.
#AIO_DYNAMODB_TABLE=
#AIO_S3_BUCKET=

# Cloud Run / Cloud Tasks (production only; K_SERVICE is set by Cloud Run).
# CLOUD_RUN_SERVICE_URL is REQUIRED for Cloud Tasks dispatch — a service URL
# embeds a deployment-specific hash and cannot be derived from K_SERVICE:
#CLOUD_RUN_SERVICE_URL=
#GCP_PROJECT_ID=
#CLOUD_TASKS_LOCATION=
#CLOUD_TASKS_QUEUE=
#CLOUD_TASKS_SA_EMAIL=

# Hugging Face cache directory (standard HF variables), honoured by the local
# Qwen/MiniCPM annotation backends when locating downloaded model weights.
#HF_HOME=
#HF_HUB_CACHE=

# YouTube PO-token provider script location (media downloads from datacenter
# IPs; not needed locally).
#BGUTIL_POT_SERVER_HOME=

# Scraper cookies as a Netscape-format file. On Cloud Run cookies come from
# gs://<bucket>/secrets/{platform}_cookies.txt; on a local Mac they are
# extracted from the Chrome profile. Use these anywhere neither applies
# (Linux dev boxes, CI, a headless drain box).
#
# The per-platform variable wins over the shared one, and BOTH are ignored
# unless the path actually exists on disk. Platform is upper-cased:
#YTDLP_COOKIE_FILE_TIKTOK=
#YTDLP_COOKIE_FILE_INSTAGRAM=
#YTDLP_COOKIE_FILE_YOUTUBE=
# Shared fallback for every platform:
#YTDLP_COOKIE_FILE=

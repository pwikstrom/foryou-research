# Environment variables used by FYP. Copy relevant lines into your shell
# profile or a local .env (gitignored) — full reference: docs/configuration.md
#
# None of these are required for a local, GCS-free run (see
# config/config.local.toml.example for the storage toggles).

# Gemini API access (annotation, embeddings). Required to run annotation.
#GEMINI_API_KEY=

# Flask session secret. Falls back to a dev-only value locally; REQUIRED in
# any deployed environment.
#FLASK_SECRET_KEY=

# GCS bucket for data/media/cache when the use_gcs_* toggles are on.
#FYP_GCS_BUCKET_NAME=

# Force ALL storage to GCS from a local process (e.g. the local scrape-queue
# drain runbook in AGENT.md). Refuses local fallback if GCS is unreachable.
#FYP_FORCE_GCS=1

# Ignore any runtime-uploaded annotation contract; use the committed one.
# Set by tests and the golden safety net.
#FYP_BAKED_CONTRACTS_ONLY=1

# Cloud Run / Cloud Tasks (production only; K_SERVICE is set by Cloud Run):
#CLOUD_RUN_SERVICE_URL=
#GCP_PROJECT_ID=
#CLOUD_TASKS_LOCATION=
#CLOUD_TASKS_QUEUE=
#CLOUD_TASKS_SA_EMAIL=

# YouTube PO-token provider script location (media downloads from datacenter
# IPs; not needed locally).
#BGUTIL_POT_SERVER_HOME=

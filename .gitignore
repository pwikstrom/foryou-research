# config/config.toml

# Research sandboxes / scratch notebooks / manuscript drafts — never commit
sandbox/
tests/scratchpads/
NMS_manuscript_scaffold.docx

# Notebooks, anywhere, unconditionally — this repo holds none by policy. Their
# saved outputs carry real feed rows (creator handles, captions, item ids), so a
# committed .ipynb leaks participant-linked data even when its code is harmless.
# The rules above covered only sandbox/, which is how
# tests/_patrik_test_scratchpad_001.ipynb reached git history.
*.ipynb

# Raw / intermediate research data that must never reach the public repo
*.npy
*.ndjson
users.json

# Machine-local config overlay (see config/config.local.toml.example)
config/config.local.toml

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?



# Temporary research/debug data — never commit (may contain donor-derived data)
tmp/

# Coding-agent state — machine-specific paths and live API keys live here
# (launch.json and settings.local.json both carry them). Ignore the whole
# directory: a per-file rule left settings.local.json protected only by a
# machine-global ignore, which does not travel with the repository.
.claude/

# One-off / scratch code: kept locally, never published. These carry
# production ids, bucket names and donation filenames by their nature.
scripts/adhoc/
tests/debug/
tests/ab_eval/
tests/bench/

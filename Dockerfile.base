# Base image with all dependencies pre-installed.
# Rebuild only when requirements.txt changes:
#   docker build -f Dockerfile.base -t foryou-hub-base:latest .
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1

# Install C compiler and Rust (needed for gcsfs / cryptography)
RUN apt-get update && apt-get install -y \
    build-essential \
    gcc \
    cargo \
    rustc \
    ffmpeg \
    curl \
    unzip \
    && rm -rf /var/lib/apt/lists/*

# deno — JavaScript runtime for yt-dlp's YouTube n-challenge solver
# (yt-dlp-ejs in requirements.txt provides the solver scripts).
RUN curl -fsSL https://github.com/denoland/deno/releases/latest/download/deno-x86_64-unknown-linux-gnu.zip \
    -o /tmp/deno.zip \
    && unzip -q /tmp/deno.zip -d /usr/local/bin \
    && chmod +x /usr/local/bin/deno \
    && rm /tmp/deno.zip

# Node.js — build + runtime for the bgutil PO-token provider script below
# (YouTube demands proof-of-origin tokens for media streams from datacenter
# IPs; cookies alone don't pass the bot wall).
RUN curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
    && apt-get install -y nodejs \
    && rm -rf /var/lib/apt/lists/*

# bgutil PO-token provider, script mode. The pip plugin in requirements.txt
# (bgutil-ytdlp-pot-provider, same version) calls this script via yt-dlp
# extractor args — see _pot_extractor_args() in fyp/youtube_dl.py. Tokens are
# cached by the plugin (~6h TTL), so per-request node spawns are rare.
ARG BGUTIL_POT_VERSION=1.3.1
RUN curl -fsSL https://github.com/Brainicism/bgutil-ytdlp-pot-provider/archive/refs/tags/${BGUTIL_POT_VERSION}.tar.gz \
    | tar -xz -C /opt \
    && mv /opt/bgutil-ytdlp-pot-provider-${BGUTIL_POT_VERSION} /opt/bgutil-ytdlp-pot-provider \
    && cd /opt/bgutil-ytdlp-pot-provider/server \
    && npm ci \
    && npx tsc \
    && rm -rf ~/.npm

# Consumed by fyp/youtube_dl.py; absent (e.g. local dev) → provider not used.
ENV BGUTIL_POT_SERVER_HOME=/opt/bgutil-ytdlp-pot-provider/server

RUN pip install --upgrade pip

WORKDIR /app

# Install all Python dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

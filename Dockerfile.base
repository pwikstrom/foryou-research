# Base image with all dependencies pre-installed.
# Rebuild only when requirements312.txt changes:
#   gcloud builds submit --config=cloudbuild-base.yaml --project=<gcp-project> --region=australia-southeast1
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1

# Install C compiler and Rust (needed for gcsfs / cryptography)
RUN apt-get update && apt-get install -y \
    build-essential \
    gcc \
    cargo \
    rustc \
    ffmpeg \
    curl \
    unzip \
    && rm -rf /var/lib/apt/lists/*

# deno — JavaScript runtime for yt-dlp's YouTube n-challenge solver
# (yt-dlp-ejs in requirements312.txt provides the solver scripts).
RUN curl -fsSL https://github.com/denoland/deno/releases/latest/download/deno-x86_64-unknown-linux-gnu.zip \
    -o /tmp/deno.zip \
    && unzip -q /tmp/deno.zip -d /usr/local/bin \
    && chmod +x /usr/local/bin/deno \
    && rm /tmp/deno.zip

RUN pip install --upgrade pip

WORKDIR /app

# Install all Python dependencies
COPY requirements312.txt .
RUN pip install --no-cache-dir -r requirements312.txt

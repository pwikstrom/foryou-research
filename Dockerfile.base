# Base image with all dependencies pre-installed.
# Rebuild only when requirements.txt or one of the versions pinned below
# changes (see DEVELOPING.md "Cloud Run Deployment" for the Cloud Build command).
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1

# Runtime system packages: ffmpeg (YouTube DASH merge, the ffprobe that
# backfills Instagram durations); curl / unzip / xz-utils for the downloads below.
RUN apt-get update && apt-get install -y \
    ffmpeg \
    curl \
    unzip \
    xz-utils \
    && rm -rf /var/lib/apt/lists/*

# deno — JavaScript runtime for yt-dlp's YouTube n-challenge solver
# (yt-dlp-ejs in requirements.txt provides the solver scripts). Pinned so a
# rebuild cannot silently change it.
ARG DENO_VERSION=2.9.7
RUN curl -fsSL https://github.com/denoland/deno/releases/download/v${DENO_VERSION}/deno-x86_64-unknown-linux-gnu.zip \
    -o /tmp/deno.zip \
    && unzip -q /tmp/deno.zip -d /usr/local/bin \
    && chmod +x /usr/local/bin/deno \
    && rm /tmp/deno.zip

# Node.js — build + runtime for the bgutil PO-token provider script below
# (YouTube demands proof-of-origin tokens for media streams from datacenter
# IPs; cookies alone don't pass the bot wall). The official release tarball,
# checked against its published SHA-256, rather than a piped setup script.
ARG NODE_VERSION=22.23.3
RUN cd /tmp \
    && curl -fsSLO https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-x64.tar.xz \
    && curl -fsSL https://nodejs.org/dist/v${NODE_VERSION}/SHASUMS256.txt \
       | grep " node-v${NODE_VERSION}-linux-x64.tar.xz\$" | sha256sum -c - \
    && tar -xJf node-v${NODE_VERSION}-linux-x64.tar.xz -C /usr/local --strip-components=1 --no-same-owner \
    && rm node-v${NODE_VERSION}-linux-x64.tar.xz

ARG BGUTIL_POT_VERSION=1.3.1
# Consumed by fyp/scrape/youtube_dl.py; absent (e.g. local dev) → provider not used.
ENV BGUTIL_POT_SERVER_HOME=/opt/bgutil-ytdlp-pot-provider/server

WORKDIR /app
COPY requirements.txt .

# Everything that needs a compiler happens in this one layer, and the
# compilers are purged at its end, so they never ship in the image:
# - the bgutil PO-token provider, script mode (the pip plugin in
#   requirements.txt, bgutil-ytdlp-pot-provider at the same version, calls it
#   via yt-dlp extractor args — see _pot_extractor_args() in
#   fyp/scrape/youtube_dl.py; tokens are cached ~6h, so node spawns are rare);
# - the Python dependencies (gcc / Rust cover any package without a wheel).
RUN apt-get update && apt-get install -y build-essential gcc cargo rustc \
    && curl -fsSL https://github.com/Brainicism/bgutil-ytdlp-pot-provider/archive/refs/tags/${BGUTIL_POT_VERSION}.tar.gz \
       | tar -xz -C /opt \
    && mv /opt/bgutil-ytdlp-pot-provider-${BGUTIL_POT_VERSION} /opt/bgutil-ytdlp-pot-provider \
    && (cd /opt/bgutil-ytdlp-pot-provider/server && npm ci && npx tsc) \
    && pip install --upgrade pip \
    && pip install --no-cache-dir -r requirements.txt \
    && apt-get purge -y --auto-remove build-essential gcc cargo rustc \
    && rm -rf /var/lib/apt/lists/* ~/.npm ~/.cargo

# Base image with all dependencies pre-installed.
# Rebuild only when requirements312.txt changes:
#   gcloud builds submit --tag australia-southeast1-docker.pkg.dev/<gcp-project>/cloud-run-source-deploy/fyp-base:latest -f Dockerfile.base .
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1

# Install C compiler and Rust (needed for gcsfs / cryptography)
RUN apt-get update && apt-get install -y \
    build-essential \
    gcc \
    cargo \
    rustc \
    ffmpeg \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --upgrade pip

WORKDIR /app

# Install all Python dependencies
COPY requirements312.txt .
RUN pip install --no-cache-dir -r requirements312.txt
